{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "content": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minimum": 10,
          "maximum": 5000
        },
        "summary": {
          "type": "string"
        },
        "duration": {
          "type": "string",
          "minimum": 1
        },
        "redirectUrl": {
          "type": "string"
        },
        "appIcon": {
          "type": "string",
          "format": "uri"
        },
        "externalId": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "string",
            "minimum": 50,
            "maximum": 2000
        },
        "topic": {
          "type": "string"
        },
        "lastUpdatedOn": {
          "type": "string"
        },
        "createdOn": {
          "type": "string"
        },
        "contentId": {
          "type": "string"
        },
        "searchTags": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "programId": {
          "type": "string"
        },
        "courseProvider": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": "string",
              "logoUrl": "string"
            },
            "additionalProperties": false
          }
        },
        "courseType": {
          "type": "string",
          "enum": ["paid", "free"]
        },
        "courseEnrolLimit": {
          "type": "number",
          "minimum": 0
        },
        "requiredKarmaPoints": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "description",
        "redirectUrl",
        "appIcon",
        "externalId"
      ]
    }
  },
  "additionalProperties": false
}
